<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SABAR PRINTING – Sistem Kasir Percetakan</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for Dashboard Reports -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- html2canvas for JPG Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- QRCode.js for QRIS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- JsBarcode for Transaction Barcode -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Print Styles */
        @media print {
            body * { visibility: hidden !important; }
            #receipt-modal-preview, #receipt-modal-preview * { visibility: visible !important; }
            #receipt-modal-preview { 
                position: absolute !important; 
                left: 0 !important; 
                top: 0 !important; 
                width: 100% !important; 
                margin: 0 !important;
                padding: 0 !important;
                box-shadow: none !important;
                border: none !important;
                background-color: #ffffff !important;
            }
            .no-print { display: none !important; }
        }

        .kanban-col { min-height: 200px; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased h-screen flex flex-col overflow-hidden">

    <!-- TOP NAVIGATION BAR -->
    <header class="bg-brand-900 text-white h-14 flex items-center justify-between px-4 shrink-0 shadow-md z-30 relative">
        <div class="flex items-center space-x-3">
            <button onclick="app.toggleSidebar()" class="lg:hidden text-white hover:text-brand-200 focus:outline-none mr-1">
                <i class="fas fa-bars text-xl"></i>
            </button>
            <i class="fas fa-print text-xl text-brand-500 hidden sm:block"></i>
            <span class="font-bold text-base sm:text-lg tracking-wider">SABAR PRINTING</span>
            <span class="text-xs bg-brand-800 text-brand-100 px-2.5 py-0.5 rounded-full font-medium hidden md:inline-block">POS Percetakan</span>
        </div>

        <div class="flex items-center space-x-4">
            <!-- Current Time Display -->
            <div class="text-xs text-brand-100 hidden md:block" id="live-clock">--:--:--</div>

            <!-- Active User & Role Switcher -->
            <div class="flex items-center space-x-2 bg-brand-800/80 px-3 py-1 rounded-lg border border-brand-700">
                <i class="fas fa-user-circle text-brand-100 text-sm"></i>
                <div class="text-xs">
                    <span class="font-medium block leading-tight text-white" id="user-display-name">Kasir Utama</span>
                    <span class="text-[10px] text-brand-100 block" id="user-display-role">Role: Admin</span>
                </div>
                <select id="role-selector" onchange="app.switchRole(this.value)" class="bg-brand-900 text-xs text-white rounded px-1.5 py-0.5 border border-brand-700 focus:outline-none cursor-pointer">
                    <option value="Admin">Admin</option>
                    <option value="Owner">Owner</option>
                    <option value="Kasir">Kasir</option>
                    <option value="Operator Produksi">Operator Produksi</option>
                </select>
            </div>
        </div>
    </header>

    <!-- MAIN APPLICATION CONTAINER -->
    <div class="flex flex-1 overflow-hidden relative">

        <!-- MOBILE OVERLAY -->
        <div id="mobile-overlay" class="fixed inset-0 bg-slate-900/50 z-30 hidden lg:hidden backdrop-blur-sm" onclick="app.toggleSidebar()"></div>

        <!-- SIDEBAR NAVIGATION -->
        <aside id="sidebar" class="w-64 bg-white border-r border-slate-200 flex flex-col shrink-0 shadow-sm z-40 fixed inset-y-0 left-0 transform -translate-x-full transition-transform duration-300 lg:relative lg:translate-x-0 h-full">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center lg:hidden bg-brand-50">
                <div class="flex items-center gap-2 text-brand-800 font-bold">
                    <i class="fas fa-print"></i> Menu Utama
                </div>
                <button onclick="app.toggleSidebar()" class="text-slate-500 hover:text-slate-700 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
                <button onclick="app.navigate('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100 bg-slate-100">
                    <i class="fas fa-chart-line w-5 text-center text-brand-600"></i>
                    <span>Dashboard</span>
                </button>
                <button onclick="app.navigate('pos')" id="nav-pos" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100">
                    <i class="fas fa-cash-register w-5 text-center text-emerald-600"></i>
                    <span>Kasir (POS)</span>
                </button>
                <button onclick="app.navigate('production')" id="nav-production" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100">
                    <i class="fas fa-tasks w-5 text-center text-amber-600"></i>
                    <span>Pesanan / Produksi</span>
                    <span id="badge-order-count" class="ml-auto bg-amber-100 text-amber-800 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
                </button>
                <button onclick="app.navigate('customers')" id="nav-customers" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100">
                    <i class="fas fa-users w-5 text-center text-blue-600"></i>
                    <span>Data Pelanggan</span>
                </button>
                <button onclick="app.navigate('products')" id="nav-products" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100">
                    <i class="fas fa-boxes w-5 text-center text-indigo-600"></i>
                    <span>Produk & Jasa</span>
                </button>
                <button onclick="app.navigate('reports')" id="nav-reports" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100">
                    <i class="fas fa-file-invoice-dollar w-5 text-center text-purple-600"></i>
                    <span>Laporan Transaksi</span>
                </button>
            </nav>

            <div class="p-3 border-t border-slate-200 text-xs text-slate-400 text-center">
                SABAR PRINTING POS v2.0
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-6" id="main-content">

            <!-- DASHBOARD VIEW -->
            <section id="view-dashboard" class="view-section space-y-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800">Dashboard Ringkasan</h1>
                        <p class="text-xs text-slate-500">Overview performa bisnis percetakan hari ini</p>
                    </div>
                    <div class="text-xs text-slate-500 bg-white px-3 py-1.5 rounded-lg border shadow-sm">
                        <i class="far fa-calendar-alt mr-1 text-brand-600"></i> <span id="dash-date-display">--</span>
                    </div>
                </div>

                <!-- STAT CARDS -->
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-xs text-slate-500 font-medium block">Penjualan Hari Ini</span>
                        <span class="text-lg font-bold text-slate-800 block mt-1" id="stat-sales-today">Rp 0</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-xs text-slate-500 font-medium block">Transaksi Hari Ini</span>
                        <span class="text-lg font-bold text-brand-600 block mt-1" id="stat-trx-today">0</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-xs text-slate-500 font-medium block">Omset Bulan Ini</span>
                        <span class="text-lg font-bold text-emerald-600 block mt-1" id="stat-sales-month">Rp 0</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-xs text-slate-500 font-medium block">Sedang Diproses</span>
                        <span class="text-lg font-bold text-amber-600 block mt-1" id="stat-orders-process">0</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-xs text-slate-500 font-medium block">Siap Diambil</span>
                        <span class="text-lg font-bold text-blue-600 block mt-1" id="stat-orders-ready">0</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-xs text-slate-500 font-medium block">Total Pelanggan</span>
                        <span class="text-lg font-bold text-rose-600 block mt-1" id="stat-customers">0</span>
                    </div>
                </div>

                <!-- CHART & TOP PRODUCTS -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <h3 class="text-sm font-bold text-slate-800 mb-4">Grafik Penjualan 7 Hari Terakhir</h3>
                        <div class="h-64">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col">
                        <h3 class="text-sm font-bold text-slate-800 mb-4">Produk/Jasa Terlaris</h3>
                        <div class="flex-1 overflow-y-auto space-y-3" id="top-products-list">
                            <!-- Populated dynamically -->
                        </div>
                    </div>
                </div>
            </section>

            <!-- KASIR / POS VIEW -->
            <section id="view-pos" class="view-section hidden h-full flex flex-col lg:flex-row gap-4 relative pb-16 lg:pb-0">
                <!-- LEFT PANEL: PRODUCT SEARCH & GRID -->
                <div class="flex-1 flex flex-col bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden p-3 sm:p-4 h-full">
                    <!-- Filters -->
                    <div class="flex flex-col sm:flex-row gap-2 mb-4">
                        <div class="relative flex-1">
                            <i class="fas fa-search absolute left-3 top-3 text-slate-400 text-sm"></i>
                            <input type="text" id="pos-search" oninput="app.renderPosProducts()" placeholder="Cari produk atau jasa percetakan..." class="w-full pl-9 pr-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none">
                        </div>
                        <select id="pos-category-filter" onchange="app.renderPosProducts()" class="border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none">
                            <option value="">Semua Kategori</option>
                            <option value="Cetak Outdoor">Cetak Outdoor (Banner/Spanduk)</option>
                            <option value="Cetak Indoor">Cetak Indoor (A3+, Stiker)</option>
                            <option value="Dokumen">Dokumen & Fotokopi</option>
                            <option value="Merchandise">Merchandise (Mug, Kaos)</option>
                            <option value="Jilid & Finishing">Jilid & Finishing</option>
                        </select>
                    </div>

                    <!-- Products Grid -->
                    <div class="flex-1 overflow-y-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3 p-1 content-start" id="pos-product-grid">
                        <!-- Items rendered dynamically -->
                    </div>
                </div>

                <!-- FLOATING CART BUTTON (MOBILE) -->
                <button onclick="app.toggleMobileCart()" class="lg:hidden fixed bottom-4 right-4 z-30 bg-brand-600 text-white w-14 h-14 rounded-full shadow-2xl flex items-center justify-center hover:bg-brand-700 transition-transform transform hover:scale-105 border-2 border-white">
                    <i class="fas fa-shopping-cart text-2xl"></i>
                    <span id="mobile-cart-badge" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[11px] font-bold w-6 h-6 rounded-full flex items-center justify-center border-2 border-white shadow-sm">0</span>
                </button>

                <!-- RIGHT PANEL: CART & CHECKOUT -->
                <div id="pos-cart-modal" class="fixed inset-0 z-50 bg-slate-900/50 hidden lg:!block lg:static lg:inset-auto lg:bg-transparent lg:w-96 lg:z-auto">
                    <div class="absolute bottom-0 w-full h-[85vh] lg:static lg:h-full lg:w-full bg-white rounded-t-2xl lg:rounded-xl border border-slate-200 shadow-2xl lg:shadow-sm flex flex-col overflow-hidden transition-transform duration-300 transform translate-y-full lg:translate-y-0" id="pos-cart-container">
                        <div class="p-3 bg-white lg:bg-slate-50 border-b border-slate-200 flex justify-between items-center shrink-0">
                            <h3 class="font-bold text-sm text-slate-800"><i class="fas fa-shopping-cart text-brand-600 mr-2"></i>Keranjang Kasir</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-mono font-bold bg-brand-100 text-brand-800 px-2 py-0.5 rounded" id="pos-trx-no">TRX-000000</span>
                                <button onclick="app.toggleMobileCart()" class="lg:hidden w-7 h-7 bg-slate-100 rounded-full flex items-center justify-center text-slate-500 hover:bg-slate-700 transition"><i class="fas fa-times"></i></button>
                            </div>
                        </div>

                    <!-- Customer Selector -->
                    <div class="p-3 border-b border-slate-100 bg-slate-50/50 flex gap-2 shrink-0">
                        <select id="pos-customer-select" class="flex-1 text-xs border rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
                            <!-- Populated dynamically -->
                        </select>
                        <button onclick="app.showCustomerModal()" title="Tambah Pelanggan Baru" class="px-3 bg-brand-600 text-white rounded-lg text-xs hover:bg-brand-700 transition">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>

                    <!-- Cart Items -->
                    <div class="flex-1 overflow-y-auto p-3 flex flex-col gap-2" id="pos-cart-items">
                        <!-- Populated dynamically -->
                    </div>

                    <!-- Total Summary & Action Buttons -->
                    <div class="p-4 border-t border-slate-200 bg-slate-50 space-y-3 shrink-0">
                        <div class="space-y-1 text-xs">
                            <div class="flex justify-between text-slate-500">
                                <span>Subtotal</span>
                                <span class="font-semibold text-slate-700" id="pos-subtotal">Rp 0</span>
                            </div>
                            <div class="flex justify-between text-slate-500 items-center">
                                <span>Diskon (Rp)</span>
                                <input type="number" id="pos-discount-input" oninput="app.updateCartTotals()" value="0" min="0" class="w-24 text-right border rounded px-1.5 py-0.5 text-xs focus:outline-none focus:ring-1 focus:ring-brand-500">
                            </div>
                            <div class="flex justify-between text-base font-bold text-slate-900 pt-2 border-t">
                                <span>TOTAL</span>
                                <span class="text-brand-600" id="pos-total">Rp 0</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 pt-1">
                            <button onclick="app.showPaymentModal(true)" class="w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs rounded-lg transition flex items-center justify-center gap-1.5 shadow-sm">
                                <i class="fas fa-clock"></i> Simpan
                            </button>
                            <button onclick="app.showPaymentModal(false)" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-lg transition flex items-center justify-center gap-1.5 shadow-sm">
                                <i class="fas fa-money-bill-wave"></i> Bayar
                            </button>
                        </div>
                    </div>
                </div>
                </div>
            </section>

            <!-- MANAJEMEN PESANAN / PRODUKSI VIEW -->
            <section id="view-production" class="view-section hidden space-y-4">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800">Manajemen Pesanan Produksi</h1>
                        <p class="text-xs text-slate-500">Pantau status pengerjaan cetak dari Antrean hingga Selesai</p>
                    </div>
                </div>

                <!-- KANBAN BOARD -->
                <div class="flex lg:grid lg:grid-cols-5 gap-4 overflow-x-auto pb-4 items-start snap-x snap-mandatory">
                    <!-- Column: Pesanan Baru -->
                    <div class="bg-slate-100 rounded-xl p-3 border border-slate-200 min-w-[260px] lg:min-w-0 snap-center shrink-0">
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider"><i class="fas fa-inbox text-blue-500 mr-1.5"></i>Baru</h4>
                            <span class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded-full font-bold" id="count-status-baru">0</span>
                        </div>
                        <div class="space-y-2 kanban-col" id="col-status-baru"></div>
                    </div>

                    <!-- Column: Diproses -->
                    <div class="bg-slate-100 rounded-xl p-3 border border-slate-200 min-w-[260px] lg:min-w-0 snap-center shrink-0">
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider"><i class="fas fa-cogs text-amber-500 mr-1.5"></i>Diproses</h4>
                            <span class="bg-amber-100 text-amber-800 text-xs px-2 py-0.5 rounded-full font-bold" id="count-status-proses">0</span>
                        </div>
                        <div class="space-y-2 kanban-col" id="col-status-proses"></div>
                    </div>

                    <!-- Column: Dicetak / Finishing -->
                    <div class="bg-slate-100 rounded-xl p-3 border border-slate-200 min-w-[260px] lg:min-w-0 snap-center shrink-0">
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider"><i class="fas fa-print text-purple-500 mr-1.5"></i>Finishing</h4>
                            <span class="bg-purple-100 text-purple-800 text-xs px-2 py-0.5 rounded-full font-bold" id="count-status-cetak">0</span>
                        </div>
                        <div class="space-y-2 kanban-col" id="col-status-cetak"></div>
                    </div>

                    <!-- Column: Siap Diambil -->
                    <div class="bg-slate-100 rounded-xl p-3 border border-slate-200 min-w-[260px] lg:min-w-0 snap-center shrink-0">
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider"><i class="fas fa-box-open text-emerald-500 mr-1.5"></i>Siap Diambil</h4>
                            <span class="bg-emerald-100 text-emerald-800 text-xs px-2 py-0.5 rounded-full font-bold" id="count-status-siap">0</span>
                        </div>
                        <div class="space-y-2 kanban-col" id="col-status-siap"></div>
                    </div>

                    <!-- Column: Selesai -->
                    <div class="bg-slate-100 rounded-xl p-3 border border-slate-200 min-w-[260px] lg:min-w-0 snap-center shrink-0">
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider"><i class="fas fa-check-circle text-slate-500 mr-1.5"></i>Selesai</h4>
                            <span class="bg-slate-200 text-slate-700 text-xs px-2 py-0.5 rounded-full font-bold" id="count-status-selesai">0</span>
                        </div>
                        <div class="space-y-2 kanban-col" id="col-status-selesai"></div>
                    </div>
                </div>
            </section>

            <!-- DATA PELANGGAN VIEW -->
            <section id="view-customers" class="view-section hidden space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800">Data Pelanggan</h1>
                        <p class="text-xs text-slate-500">Kelola informasi kontak pelanggan</p>
                    </div>
                    <button onclick="app.showCustomerModal()" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition shadow-sm">
                        <i class="fas fa-user-plus"></i> Tambah Pelanggan
                    </button>
                </div>

                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-3 border-b border-slate-100 bg-slate-50">
                        <input type="text" id="customer-search-input" oninput="app.renderCustomers()" placeholder="Cari nama atau nomor HP pelanggan..." class="w-full sm:w-72 px-3 py-1.5 border rounded-lg text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
                    </div>
                    <div class="overflow-x-auto pb-2">
                        <table class="w-full text-left border-collapse whitespace-nowrap">
                            <thead>
                                <tr class="bg-slate-50 border-b text-[11px] font-bold text-slate-500 uppercase">
                                    <th class="p-3">ID</th>
                                    <th class="p-3">Nama Pelanggan</th>
                                    <th class="p-3">No. Telp / WA</th>
                                    <th class="p-3">Alamat</th>
                                    <th class="p-3 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="customer-table-body" class="text-sm">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- PRODUK & JASA VIEW -->
            <section id="view-products" class="view-section hidden space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800">Produk & Jasa Percetakan</h1>
                        <p class="text-xs text-slate-500">Daftar tarif, cetakan, dan barang</p>
                    </div>
                    <button onclick="app.showProductModal()" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition shadow-sm">
                        <i class="fas fa-plus-circle"></i> Tambah Produk / Jasa

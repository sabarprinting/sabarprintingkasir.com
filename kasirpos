            showProductModal(id = null) {
                this.editingProductId = id;
                const modalTitle = document.getElementById('product-modal-title');
                
                if (id) {
                    const product = this.products.find(p => p.id === id);
                    if (product) {
                        modalTitle.innerText = "Edit Produk / Jasa";
                        document.getElementById('prod-code').value = product.code;
                        document.getElementById('prod-name').value = product.name;
                        document.getElementById('prod-category').value = product.category;
                        document.getElementById('prod-price').value = product.price;
                        document.getElementById('prod-type').value = product.isCustom ? "true" : "false";
                    }
                } else {
                    modalTitle.innerText = "Tambah Produk / Jasa";
                    document.getElementById('form-product').reset();
                }

                document.getElementById('modal-product').classList.remove('hidden');
                document.getElementById('modal-product').classList.add('flex');
            },

            closeProductModal() {
                document.getElementById('modal-product').classList.add('hidden');
                document.getElementById('modal-product').classList.remove('flex');
                this.editingProductId = null;
            },

            saveProduct() {
                const code = document.getElementById('prod-code').value;
                const name = document.getElementById('prod-name').value;
                const category = document.getElementById('prod-category').value;
                const price = parseFloat(document.getElementById('prod-price').value);
                const isCustom = document.getElementById('prod-type').value === "true";

                if (this.editingProductId) {
                    const index = this.products.findIndex(p => p.id === this.editingProductId);
                    if (index !== -1) {
                        this.products[index] = {
                            ...this.products[index],
                            code, name, category, price, isCustom
                        };
                    }
                } else {
                    const newId = this.products.length > 0 ? Math.max(...this.products.map(p => p.id)) + 1 : 1;
                    this.products.push({
                        id: newId,
                        code, name, category, price, isCustom
                    });
                }

                this.renderProducts();
                this.renderPosProducts();
                this.closeProductModal();
                this.showAlert("Produk berhasil disimpan.", true);
            },

            deleteProduct(id) {
                this.products = this.products.filter(p => p.id !== id);
                this.renderProducts();
                this.renderPosProducts();
                this.showAlert("Produk berhasil dihapus.", true);
            },

            // Kanban Production
            renderKanban() {
                const cols = {
                    'Baru': document.getElementById('col-status-baru'),
                    'Diproses': document.getElementById('col-status-proses'),
                    'Finishing': document.getElementById('col-status-cetak'),
                    'Siap Diambil': document.getElementById('col-status-siap'),
                    'Selesai': document.getElementById('col-status-selesai')
                };

                const counts = { 'Baru': 0, 'Diproses': 0, 'Finishing': 0, 'Siap Diambil': 0, 'Selesai': 0 };

                Object.values(cols).forEach(col => col.innerHTML = '');

                this.orders.forEach(order => {
                    counts[order.status]++;
                    const nextStatus = this.getNextStatus(order.status);
                    
                    const card = document.createElement('div');
                    card.className = 'bg-white p-3 rounded-lg border border-slate-200 shadow-sm text-xs space-y-2';
                    card.innerHTML = `
                        <div class="flex justify-between items-start">
                            <span class="font-bold font-mono text-brand-600">${order.id}</span>
                            <div class="flex flex-col items-end gap-1">
                                <span class="text-slate-400 text-[10px]"><i class="fas fa-clock"></i> ${order.deadline || '-'}</span>
                                <span class="px-1.5 py-0.5 rounded text-[8px] font-bold ${order.type === 'Lunas' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">${order.type || '-'}</span>
                            </div>
                        </div>
                        <div class="mt-1">
                            <div class="font-bold text-slate-800">${order.jobName}</div>
                            <div class="text-slate-500 text-[10px]"><i class="fas fa-user text-slate-400 mr-1"></i>${order.customer}</div>
                            <div class="text-slate-500 text-[10px] mt-1 p-1.5 bg-slate-50 rounded border border-slate-100 leading-tight whitespace-pre-wrap">${order.details}</div>
                        </div>
                        ${nextStatus ? `<button onclick="app.moveOrder('${order.id}', '${nextStatus}')" class="w-full mt-2 py-1.5 bg-slate-100 hover:bg-brand-50 text-brand-600 rounded text-[10px] font-semibold transition border border-slate-200">Geser ke ${nextStatus} &rarr;</button>` : ''}
                    `;
                    cols[order.status].appendChild(card);
                });

                document.getElementById('count-status-baru').innerText = counts['Baru'];
                document.getElementById('count-status-proses').innerText = counts['Diproses'];
                document.getElementById('count-status-cetak').innerText = counts['Finishing'];
                document.getElementById('count-status-siap').innerText = counts['Siap Diambil'];
                document.getElementById('count-status-selesai').innerText = counts['Selesai'];
                
                document.getElementById('badge-order-count').innerText = counts['Baru'] + counts['Diproses'] + counts['Finishing'];
            },

            getNextStatus(status) {
                const flow = ['Baru', 'Diproses', 'Finishing', 'Siap Diambil', 'Selesai'];
                const idx = flow.indexOf(status);
                if (idx !== -1 && idx < flow.length - 1) return flow[idx + 1];
                return null;
            },

            moveOrder(id, newStatus) {
                const order = this.orders.find(o => o.id === id);
                if(order) {
                    order.status = newStatus;
                    this.renderKanban();
                    this.updateDashboardStats();
                }
            },

            // Reports
            renderReports() {
                const tbody = document.getElementById('report-trx-table');
                tbody.innerHTML = '';
                
                [...this.transactions].reverse().forEach(trx => {
                    let actionBtns = `<button onclick="app.reprintReceipt('${trx.trxNo}')" class="text-blue-500 hover:text-blue-700" title="Lihat & Cetak Struk"><i class="fas fa-print"></i></button>`;
                    
                    // Tombol khusus Pelunasan jika status masih Hutang / DP
                    if (trx.type === 'Hutang / DP') {
                        actionBtns = `
                            <button onclick="app.showPayOffModal('${trx.trxNo}')" class="text-emerald-500 hover:text-emerald-700 mr-2" title="Pelunasan (Bayar Sisa)"><i class="fas fa-money-bill-wave"></i></button>
                            ` + actionBtns;
                    }

                    tbody.innerHTML += `
                        <tr class="border-b hover:bg-slate-50">
                            <td class="p-3 font-mono text-xs font-bold text-brand-600">${trx.trxNo}</td>
                            <td class="p-3">${new Date(trx.date).toLocaleString('id-ID')}</td>
                            <td class="p-3">${trx.customer}</td>
                            <td class="p-3"><span class="px-2 py-1 rounded text-[10px] font-bold ${trx.type==='Lunas'?'bg-emerald-100 text-emerald-700':'bg-amber-100 text-amber-700'}">${trx.type}</span></td>
                            <td class="p-3 text-right font-bold">${this.formatRp(trx.total)}</td>
                            <td class="p-3 text-center">
                                ${actionBtns}
                            </td>
                        </tr>
                    `;
                });
            },

            // Dashboard & Chart
            updateDashboardStats() {
                const today = new Date().toDateString();
                const todayTrx = this.transactions.filter(t => new Date(t.date).toDateString() === today);
                
                const salesToday = todayTrx.reduce((sum, t) => sum + t.total, 0);
                const salesMonth = this.transactions.reduce((sum, t) => sum + t.total, 0);

                document.getElementById('stat-sales-today').innerText = this.formatRp(salesToday);
                document.getElementById('stat-trx-today').innerText = todayTrx.length;
                document.getElementById('stat-sales-month').innerText = this.formatRp(salesMonth);
                
                const processCount = this.orders.filter(o => o.status === 'Baru' || o.status === 'Diproses' || o.status === 'Finishing').length;
                const readyCount = this.orders.filter(o => o.status === 'Siap Diambil').length;
                
                document.getElementById('stat-orders-process').innerText = processCount;
                document.getElementById('stat-orders-ready').innerText = readyCount;
                document.getElementById('stat-customers').innerText = this.customers.length;

                const topHtml = this.products.slice(0,3).map((p, i) => `
                    <div class="flex items-center justify-between p-2 hover:bg-slate-50 rounded border border-transparent hover:border-slate-200">
                        <div class="flex items-center gap-3">
                            <div class="w-6 h-6 rounded bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs">${i+1}</div>
                            <div>
                                <h4 class="text-xs font-bold text-slate-700">${p.name}</h4>
                                <span class="text-[10px] text-slate-400">${p.category}</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-emerald-600">${Math.floor(Math.random() * 50) + 10}x</span>
                    </div>
                `).join('');
                document.getElementById('top-products-list').innerHTML = topHtml;
            },

            initChart() {
                const ctx = document.getElementById('salesChart');
                if(!ctx) return;
                
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'],
                        datasets: [{
                            label: 'Pendapatan (Juta Rp)',
                            data: [1.2, 1.9, 1.5, 2.2, 1.8, 3.5, 2.8],
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { borderDash: [4, 4] } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        };

        // Initialize App
        window.onload = () => app.init();
    </script>
</body>
</html>

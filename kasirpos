                document.getElementById('modal-customer').classList.add('flex');
            },
            
            closeCustomerModal() {
                document.getElementById('modal-customer').classList.add('hidden');
                document.getElementById('modal-customer').classList.remove('flex');
            },

            saveCustomer() {

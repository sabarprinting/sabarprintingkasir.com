                        modal.classList.add('hidden');
                    }, 300); // Sesuaikan dengan durasi animasi
                }
            },

            // Alerts logic (Replaced native alerts)
            showAlert(msg, isSuccess = false) {
                document.getElementById('alert-message').innerText = msg;
                document.getElementById('alert-title').innerText = isSuccess ? 'Berhasil' : 'Perhatian';
                document.getElementById('alert-icon').innerHTML = isSuccess ? '<i class="fas fa-check-circle text-emerald-500"></i>' : '<i class="fas fa-exclamation-triangle text-amber-500"></i>';
                document.getElementById('modal-alert').classList.remove('hidden');
                document.getElementById('modal-alert').classList.add('flex');
            },

            closeAlert() {
                document.getElementById('modal-alert').classList.add('hidden');
                document.getElementById('modal-alert').classList.remove('flex');
            },

            // Utils
            formatRp(angka) {
                return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
            },
            
            updateClock() {
                const now = new Date();
                const timeStr = now.toLocaleTimeString('id-ID');
                const dateStr = now.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                document.getElementById('live-clock').innerText = timeStr;
                document.getElementById('dash-date-display').innerText = dateStr;
            },

            generateTrxNo() {
                const no = 'SP-' + Math.floor(Math.random() * 1000000).toString().padStart(6, '0');
                document.getElementById('pos-trx-no').innerText = no;
                return no;
            },

            // Navigation
            navigate(viewId) {
                this.currentView = viewId;
                document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));
                document.getElementById('view-' + viewId).classList.remove('hidden');
                
                document.querySelectorAll('.nav-btn').forEach(el => {
                    el.classList.remove('bg-slate-100', 'text-slate-800');
                    el.classList.add('text-slate-600');
                });
                document.getElementById('nav-' + viewId).classList.add('bg-slate-100', 'text-slate-800');

                if(viewId === 'production') this.renderKanban();
                if(viewId === 'reports') this.renderReports();
                if(viewId === 'customers') this.renderCustomers();

                // Tutup otomatis sidebar di mode Mobile setelah klik menu
                if (window.innerWidth < 1024) {
                    const sidebar = document.getElementById('sidebar');
                    const overlay = document.getElementById('mobile-overlay');
                    if (!sidebar.classList.contains('-translate-x-full')) {
                        sidebar.classList.add('-translate-x-full');
                        overlay.classList.add('hidden');
                    }
                }
            },

            switchRole(role) {
                this.role = role;
                document.getElementById('user-display-role').innerText = 'Role: ' + role;
                if(role === 'Operator Produksi') {
                    this.navigate('production');
                } else if(role === 'Kasir') {
                    this.navigate('pos');
                }
            },

            // POS Functions
            renderPosProducts() {
                const grid = document.getElementById('pos-product-grid');
                const search = document.getElementById('pos-search').value.toLowerCase();
                const category = document.getElementById('pos-category-filter').value;
                
                grid.innerHTML = '';
                
                this.products.forEach(p => {
                    if(search && !p.name.toLowerCase().includes(search)) return;
                    if(category && p.category !== category) return;
                    
                    const el = document.createElement('div');
                    el.className = 'bg-white border rounded-lg p-3 hover:border-brand-500 cursor-pointer transition flex flex-col justify-between shadow-sm hover:shadow-md';
                    el.onclick = () => this.handleProductClick(p);
                    el.innerHTML = `
                        <div>
                            <span class="text-[10px] text-slate-400 block">${p.code}</span>
                            <h4 class="text-xs font-bold text-slate-700 leading-tight mt-1">${p.name}</h4>
                        </div>
                        <div class="mt-2 text-brand-600 font-bold text-sm">
                            ${this.formatRp(p.price)}${p.isCustom ? '<span class="text-[9px] text-slate-400 font-normal">/m²</span>' : ''}
                        </div>
                    `;
                    grid.appendChild(el);
                });
            },

            handleProductClick(p) {
                if (p.isCustom) {
                    this.openPrintingModal(p);
                } else {
                    this.addToCart({
                        id: Date.now(),
                        productId: p.id,
                        name: p.name,
                        price: p.price,
                        qty: 1,
                        subtotal: p.price,
                        isCustom: false
                    });
                }
            },

            addToCart(item) {
                this.cart.push(item);
                this.renderCart();
            },

            removeFromCart(id) {
                this.cart = this.cart.filter(item => item.id !== id);
                this.renderCart();
            },

            renderCart() {
                const container = document.getElementById('pos-cart-items');
                container.innerHTML = '';
                
                if (this.cart.length === 0) {
                    container.innerHTML = '<div class="text-center text-slate-400 text-xs py-10">Keranjang kosong</div>';
                }

                this.cart.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'bg-white p-2 rounded border border-slate-100 shadow-sm flex flex-col gap-1 relative group';
                    
                    let details = '';
                    if (item.isCustom) {
                        details = `<div class="text-[10px] text-slate-500">${item.jobName} | Uk: ${item.length}x${item.width}m | Bhn: ${item.material || '-'}</div>`;
                    }

                    div.innerHTML = `
                        <div class="flex justify-between items-start pr-6">
                            <span class="font-semibold text-slate-700 text-xs">${item.name}</span>
                            <span class="font-bold text-xs">${this.formatRp(item.subtotal)}</span>
                        </div>
                        ${details}
                        <div class="flex justify-between items-center text-[10px] text-slate-500">
                            <span>${item.qty} x ${this.formatRp(item.price)}</span>
                        </div>
                        <button onclick="app.removeFromCart(${item.id})" class="absolute top-2 right-2 text-red-400 hover:text-red-600 opacity-0 group-hover:opacity-100 transition">
                            <i class="fas fa-trash text-xs"></i>
                        </button>
                    `;
                    container.appendChild(div);
                });
                this.updateCartTotals();
            },

            updateCartTotals() {
                const subtotal = this.cart.reduce((sum, item) => sum + item.subtotal, 0);
                let discount = parseFloat(document.getElementById('pos-discount-input').value) || 0;
                const total = subtotal - discount;
                
                this.discount = discount;
                document.getElementById('pos-subtotal').innerText = this.formatRp(subtotal);
                document.getElementById('pos-total').innerText = this.formatRp(total);
                
                // Update badge (angka) pada tombol floating keranjang HP
                const badge = document.getElementById('mobile-cart-badge');
                if (badge) {
                    const totalQty = this.cart.reduce((sum, item) => sum + item.qty, 0);
                    badge.innerText = totalQty;
                }
            },

            // Printing Specs Modal
            openPrintingModal(product) {
                document.getElementById('spec-product-id').value = product.id;
                document.getElementById('spec-modal-title').innerText = product.name;
                document.getElementById('spec-price').value = product.price;
                
                // reset form
                document.getElementById('spec-job-name').value = '';
                document.getElementById('spec-material').value = '';
                document.getElementById('spec-finishing').value = '';
                document.getElementById('spec-length').value = '';
                document.getElementById('spec-width').value = '';
                document.getElementById('spec-qty').value = '1';
                document.getElementById('spec-deadline').value = '';
                document.getElementById('spec-notes').value = '';
                document.getElementById('spec-subtotal-display').innerText = 'Rp 0';

                document.getElementById('modal-printing-spec').classList.remove('hidden');
                document.getElementById('modal-printing-spec').classList.add('flex');
            },

            closePrintingModal() {
                document.getElementById('modal-printing-spec').classList.add('hidden');
                document.getElementById('modal-printing-spec').classList.remove('flex');
            },

            calcSpecTotal() {
                const p = parseFloat(document.getElementById('spec-length').value) || 0;
                const l = parseFloat(document.getElementById('spec-width').value) || 0;
                const qty = parseInt(document.getElementById('spec-qty').value) || 1;
                const price = parseFloat(document.getElementById('spec-price').value) || 0;
                
                let area = p * l;
                if(area === 0) area = 1; // fallback if dimension not used (e.g. per pcs)
                
                const subtotal = area * qty * price;
                document.getElementById('spec-subtotal-display').innerText = this.formatRp(subtotal);
            },

            addPrintingItemToCart() {
                const productId = document.getElementById('spec-product-id').value;
                const product = this.products.find(p => p.id == productId);
                
                const p = parseFloat(document.getElementById('spec-length').value) || 0;
                const l = parseFloat(document.getElementById('spec-width').value) || 0;
                const qty = parseInt(document.getElementById('spec-qty').value) || 1;
                const price = parseFloat(document.getElementById('spec-price').value) || 0;
                
                let area = p * l;
                if(area === 0) area = 1;
                const subtotal = area * qty * price;

                const item = {
                    id: Date.now(),
                    productId: product.id,
                    name: product.name,
                    isCustom: true,
                    jobName: document.getElementById('spec-job-name').value,
                    material: document.getElementById('spec-material').value,
                    finishing: document.getElementById('spec-finishing').value,
                    length: p,
                    width: l,
                    qty: qty,
                    price: price,
                    subtotal: subtotal,
                    deadline: document.getElementById('spec-deadline').value,
                    notes: document.getElementById('spec-notes').value
                };

                this.addToCart(item);
                this.closePrintingModal();
            },

            // Payment & Checkout
            showPaymentModal(isSaveOnly = false) {
                if (this.cart.length === 0) {
                    this.showAlert("Keranjang kosong! Silakan tambahkan produk atau jasa terlebih dahulu.");
                    return;
                }
                this.isSavedOrder = isSaveOnly;
                
                const subtotal = this.cart.reduce((sum, item) => sum + item.subtotal, 0);
                const total = subtotal - this.discount;
                
                document.getElementById('payment-total-amount').innerText = this.formatRp(total);
                document.getElementById('payment-cash').value = '';
                document.getElementById('payment-change').innerText = 'Rp 0';
                
                document.getElementById('modal-payment').classList.remove('hidden');
                document.getElementById('modal-payment').classList.add('flex');
            },

            closePaymentModal() {
                document.getElementById('modal-payment').classList.add('hidden');
                document.getElementById('modal-payment').classList.remove('flex');
            },

            calcPaymentChange() {
                const subtotal = this.cart.reduce((sum, item) => sum + item.subtotal, 0);
                const total = subtotal - this.discount;
                const cash = parseFloat(document.getElementById('payment-cash').value) || 0;
                const change = cash - total;
                
                const changeEl = document.getElementById('payment-change');
                if (change < 0) {
                    changeEl.innerText = 'Kurang: ' + this.formatRp(Math.abs(change));
                    changeEl.classList.replace('text-emerald-500', 'text-rose-500');
                } else {
                    changeEl.innerText = this.formatRp(change);
                    changeEl.classList.replace('text-rose-500', 'text-emerald-500');
                }
            },

            processPayment() {
                const subtotal = this.cart.reduce((sum, item) => sum + item.subtotal, 0);
                const total = subtotal - this.discount;
                const cash = parseFloat(document.getElementById('payment-cash').value) || 0;
                
                if (!this.isSavedOrder && cash < total) {
                    this.showAlert("Uang yang diterima tidak cukup untuk membayar tagihan!");
                    return;
                }

                const trxNo = document.getElementById('pos-trx-no').innerText;
                const custId = document.getElementById('pos-customer-select').value;
                const customer = this.customers.find(c => c.id == custId) || { name: 'Umum' };
                
                let paymentStatus = 'Status : LUNAS';
                if (this.isSavedOrder) {
                    if (cash >= total && cash > 0) {
                        paymentStatus = 'Status : DP';
                    } else {
                        paymentStatus = 'Status : BELUM BAYAR';
                    }
                }

                const transaction = {
                    trxNo: trxNo,
                    date: new Date().toISOString(),
                    customer: customer.name,
                    items: [...this.cart],
                    subtotal: subtotal,
                    discount: this.discount,
                    total: total,
                    type: this.isSavedOrder ? 'Hutang / DP' : 'Lunas',
                    statusPayment: paymentStatus,
                    cash: cash,
                    change: cash - total
                };
                
                this.transactions.push(transaction);

                // Tambahkan transaksi ke Kanban Produksi (Terintegrasi dengan kasir)
                const orderDetails = this.cart.map(item => {
                    return item.isCustom ? `${item.name} (${item.length}x${item.width}m) - Qty: ${item.qty}` : `${item.name} - Qty: ${item.qty}`;
                }).join('<br>');
                
                const customItem = this.cart.find(i => i.isCustom && i.jobName);
                const jobName = customItem ? customItem.jobName : `Pesanan ${customer.name}`;
                const deadline = customItem ? customItem.deadline : '';

                this.orders.push({
                    id: trxNo,
                    trxNo: trxNo,
                    jobName: jobName,
                    customer: customer.name,
                    details: orderDetails,
                    deadline: deadline || new Date().toISOString().split('T')[0],
                    status: 'Baru',
                    type: transaction.type
                });

                this.updateDashboardStats();
                this.renderKanban();
                
                if (!this.isSavedOrder) {
                    this.printReceipt(transaction, cash, cash - total);
                } else {
                    this.showAlert("Pesanan berhasil disimpan ke daftar produksi!", true);
                }

                // Reset POS
                this.cart = [];
                this.discount = 0;
                document.getElementById('pos-discount-input').value = 0;
                this.generateTrxNo();
                this.renderCart();
                this.closePaymentModal();
                
                // Tutup laci keranjang HP jika sedang terbuka
                if (window.innerWidth < 1024) {
                    const cartModal = document.getElementById('pos-cart-modal');
                    if (cartModal && !cartModal.classList.contains('hidden')) {
                        this.toggleMobileCart();
                    }
                }
            },

            printReceipt(trx, cash, change) {
                document.getElementById('rcpt-trx').innerText = trx.trxNo;
                document.getElementById('rcpt-date').innerText = new Date(trx.date).toLocaleDateString('id-ID');
                document.getElementById('rcpt-cust').innerText = trx.customer;
                document.getElementById('rcpt-status-pay').innerText = trx.statusPayment || 'Status : LUNAS';
                
                const itemsContainer = document.getElementById('rcpt-items');
                itemsContainer.innerHTML = '';
                trx.items.forEach((item, index) => {
                    itemsContainer.innerHTML += `
                        <div class="mb-1">
                            <div class="flex justify-between"><span class="pr-2">${index + 1}. ${item.name}</span><span>${this.formatRp(item.subtotal)}</span></div>
                            <div class="text-[8px] text-gray-500 ml-3">${item.qty}x ${this.formatRp(item.price)}</div>
                        </div>
                    `;
                });

                document.getElementById('rcpt-sub').innerText = this.formatRp(trx.subtotal);
                document.getElementById('rcpt-disc').innerText = this.formatRp(trx.discount);
                document.getElementById('rcpt-tot').innerText = this.formatRp(trx.total);
                document.getElementById('rcpt-cash').innerText = this.formatRp(cash);
                document.getElementById('rcpt-change').innerText = this.formatRp(change);

                // Generate QR DANA Dinamis
                const qrisContainer = document.getElementById('rcpt-qris');
                qrisContainer.innerHTML = ''; // Bersihkan QR sebelumnya
                try {
                    new QRCode(qrisContainer, {
                        text: `https://link.dana.id/mme?phone=081341226191`, 
                        width: 90,
                        height: 90,
                        colorDark : "#000000",
                        colorLight : "#ffffff",
                        correctLevel : QRCode.CorrectLevel.M
                    });
                } catch (e) {
                    console.log("Error generating QR", e);
                }

                const modal = document.getElementById('receipt-modal-preview');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            },

            downloadReceiptJPG() {
                const receiptElement = document.getElementById('receipt-content');
                const trxNo = document.getElementById('rcpt-trx').innerText;
                const originalBg = receiptElement.style.backgroundColor;
                
                // Set background color secara eksplisit agar tidak transparan/hitam di hasil download
                receiptElement.style.backgroundColor = '#ffffff';

                // Gunakan html2canvas untuk merender div struk menjadi gambar
                html2canvas(receiptElement, {
                    scale: 2, // Kualitas resolusi lebih tinggi
                    backgroundColor: "#ffffff",
                    useCORS: true // Membantu merender gambar eksternal (seperti logo jika diizinkan CORS)
                }).then(canvas => {
                    // Kembalikan background aslinya
                    receiptElement.style.backgroundColor = originalBg;

                    // Convert canvas ke format base64 gambar JPG
                    const imgData = canvas.toDataURL('image/jpeg', 1.0);
                    
                    // Buat elemen link anchor virtual untuk men-trigger download
                    const link = document.createElement('a');
                    link.download = `Struk_${trxNo}.jpg`;
                    link.href = imgData;
                    
                    // Trigger proses klik
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    
                    this.showAlert("Struk berhasil diunduh sebagai file JPG!", true);
                }).catch(err => {
                    console.error("Error generating JPG: ", err);
                    receiptElement.style.backgroundColor = originalBg;
                    this.showAlert("Gagal mengunduh struk. Silakan coba lagi.");
                });
            },

            reprintReceipt(trxNo) {
                const trx = this.transactions.find(t => t.trxNo === trxNo);
                if (trx) {
                    this.printReceipt(trx, trx.cash || 0, trx.change || 0);
                } else {
                    this.showAlert('Data transaksi tidak ditemukan.');
                }
            },

            // Pay Off / Pelunasan
            showPayOffModal(trxNo) {
                const trx = this.transactions.find(t => t.trxNo === trxNo);
                if (!trx) return;

                const remaining = trx.total - trx.cash;

                document.getElementById('payoff-trx-no').value = trx.trxNo;
                document.getElementById('payoff-total').innerText = this.formatRp(trx.total);
                document.getElementById('payoff-paid').innerText = this.formatRp(trx.cash);
                document.getElementById('payoff-remaining').innerText = this.formatRp(remaining);
                
                document.getElementById('payoff-cash').value = '';
                document.getElementById('payoff-change').innerText = 'Rp 0';
                
                document.getElementById('modal-payoff').classList.remove('hidden');
                document.getElementById('modal-payoff').classList.add('flex');
            },

            closePayOffModal() {
                document.getElementById('modal-payoff').classList.add('hidden');
                document.getElementById('modal-payoff').classList.remove('flex');
            },

            calcPayOffChange() {
                const trxNo = document.getElementById('payoff-trx-no').value;
                const trx = this.transactions.find(t => t.trxNo === trxNo);
                if (!trx) return;

                const remaining = trx.total - trx.cash;
                const newCash = parseFloat(document.getElementById('payoff-cash').value) || 0;
                const change = newCash - remaining;
                
                const changeEl = document.getElementById('payoff-change');
                if (change < 0) {
                    changeEl.innerText = 'Kurang: ' + this.formatRp(Math.abs(change));
                    changeEl.classList.replace('text-emerald-500', 'text-rose-500');
                } else {
                    changeEl.innerText = this.formatRp(change);
                    changeEl.classList.replace('text-rose-500', 'text-emerald-500');
                }
            },

            processPayOff() {
                const trxNo = document.getElementById('payoff-trx-no').value;
                const trx = this.transactions.find(t => t.trxNo === trxNo);
                if (!trx) return;

                const remaining = trx.total - trx.cash;
                const newCash = parseFloat(document.getElementById('payoff-cash').value) || 0;

                if (newCash < remaining) {
                    this.showAlert("Uang yang diterima tidak cukup untuk melunasi sisa tagihan!");
                    return;
                }

                // Update Data Transaksi
                trx.cash += newCash; 
                trx.change = trx.cash - trx.total;
                trx.type = 'Lunas';
                trx.statusPayment = 'Status : LUNAS';

                // Update Status Order di Kanban Produksi (Jika ada)
                const order = this.orders.find(o => o.trxNo === trxNo);
                if (order) {
                    order.type = 'Lunas';
                    this.renderKanban();
                }

                this.renderReports();
                this.updateDashboardStats();
                
                // Cetak ulang struk terbaru (Lunas)
                this.printReceipt(trx, trx.cash, trx.change);

                this.closePayOffModal();
                this.showAlert("Pembayaran berhasil dilunasi!", true);
            },

